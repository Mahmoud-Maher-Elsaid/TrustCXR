{
  "schema_version": "1.0",
  "split_policy": {
    "method": "DETERMINISTIC_PATIENT_HASH",
    "train": 0.8,
    "validation": 0.1,
    "test": 0.1,
    "unresolved_identity_action": "WITHHOLD_FROM_SPLITS"
  },
  "datasets": [
    {
      "dataset_id": "nih_chestxray14",
      "folder": "01_NIH_ChestXray14",
      "name": "NIH ChestXray14",
      "adapter_kind": "multi_label_classification",
      "metadata_patterns": ["*.csv"],
      "image_key_columns": ["Image Index", "image", "filename"],
      "patient_columns": ["Patient ID", "patient_id"],
      "study_columns": ["Follow-up #", "study_id"],
      "label_columns": ["Finding Labels"],
      "label_mode": "single_column",
      "identity_policy": "VERIFIED_METADATA_PATIENT",
      "join_key_mode": "basename"
    },
    {
      "dataset_id": "vinbigdata",
      "folder": "02_VinBigData",
      "name": "VinBigData Chest X-ray Abnormalities Detection",
      "adapter_kind": "object_detection",
      "metadata_patterns": ["*.csv"],
      "image_key_columns": ["image_id", "image", "filename"],
      "patient_columns": ["patient_id", "PatientID"],
      "study_columns": ["study_id", "StudyInstanceUID"],
      "label_columns": ["class_name", "class"],
      "label_mode": "single_column",
      "identity_policy": "VERIFIED_DICOM_PATIENT_OR_WITHHOLD",
      "join_key_mode": "basename"
    },
    {
      "dataset_id": "indiana_reports",
      "folder": "03_Indiana_Reports",
      "name": "Indiana University Chest X-ray Reports",
      "adapter_kind": "image_report_join",
      "metadata_patterns": ["*.csv"],
      "image_key_columns": ["filename", "image", "uid"],
      "patient_columns": ["patient_id", "subject_id"],
      "study_columns": ["uid", "study_id"],
      "label_columns": ["MeSH", "Problems"],
      "label_mode": "single_column",
      "identity_policy": "STUDY_ONLY_WITHHOLD_PATIENT_SPLIT",
      "join_key_mode": "basename"
    },
    {
      "dataset_id": "nih_chexmask",
      "folder": "04_NIH_CheXmask",
      "name": "NIH CheXmask",
      "adapter_kind": "container",
      "metadata_patterns": ["*.csv", "*.tsv"],
      "image_key_columns": ["image_id", "Image Index", "filename"],
      "patient_columns": ["patient_id", "Patient ID"],
      "study_columns": ["study_id"],
      "label_columns": [],
      "label_mode": "none",
      "identity_policy": "CROSS_DATASET_CONTAINER_PENDING",
      "join_key_mode": "basename"
    },
    {
      "dataset_id": "crd_masks",
      "folder": "05_CRD_Masks",
      "name": "Chest Radiography Database Lung Masks",
      "adapter_kind": "paired_image_mask",
      "metadata_patterns": ["*.csv", "*.tsv"],
      "image_key_columns": ["image", "filename", "image_id"],
      "patient_columns": ["patient_id", "Patient ID"],
      "study_columns": ["study_id"],
      "label_columns": [],
      "label_mode": "none",
      "identity_policy": "IMAGE_PROXY_REVIEW_REQUIRED",
      "join_key_mode": "basename"
    },
    {
      "dataset_id": "rsna_pneumonia",
      "folder": "06_RSNA_Pneumonia",
      "name": "RSNA Pneumonia Detection Challenge",
      "adapter_kind": "object_detection",
      "metadata_patterns": ["*.csv"],
      "image_key_columns": ["patientId", "patient_id", "image_id"],
      "patient_columns": ["patientId", "patient_id"],
      "study_columns": ["study_id", "StudyInstanceUID"],
      "label_columns": ["Target", "class"],
      "label_mode": "rsna_target",
      "identity_policy": "VERIFIED_METADATA_PATIENT",
      "join_key_mode": "basename"
    },
    {
      "dataset_id": "chexpert_small",
      "folder": "07_CheXpert_Small",
      "name": "CheXpert Small",
      "adapter_kind": "multi_label_classification",
      "metadata_patterns": ["*.csv"],
      "image_key_columns": ["Path", "path", "image"],
      "patient_columns": ["patient_id"],
      "study_columns": ["study_id"],
      "label_columns": [
        "No Finding",
        "Enlarged Cardiomediastinum",
        "Cardiomegaly",
        "Lung Opacity",
        "Lung Lesion",
        "Edema",
        "Consolidation",
        "Pneumonia",
        "Atelectasis",
        "Pneumothorax",
        "Pleural Effusion",
        "Pleural Other",
        "Fracture",
        "Support Devices"
      ],
      "label_mode": "binary_columns",
      "identity_policy": "VERIFIED_PATH_PATIENT",
      "join_key_mode": "path_tail_3"
    },
    {
      "dataset_id": "siim_pneumothorax",
      "folder": "08_SIIM_Pneumothorax",
      "name": "SIIM-ACR Pneumothorax Segmentation",
      "adapter_kind": "rle_segmentation",
      "metadata_patterns": ["*.csv"],
      "image_key_columns": ["ImageId", "Image ID", "image_id"],
      "patient_columns": ["patient_id", "PatientID"],
      "study_columns": ["study_id", "StudyInstanceUID"],
      "label_columns": ["EncodedPixels", "Encoded Pixels"],
      "label_mode": "siim_rle",
      "identity_policy": "VERIFIED_DICOM_PATIENT_OR_WITHHOLD",
      "join_key_mode": "basename"
    },
    {
      "dataset_id": "tbx11k",
      "folder": "09_TBX11K",
      "name": "TBX11K",
      "adapter_kind": "classification_detection",
      "metadata_patterns": ["*.csv", "*.tsv"],
      "image_key_columns": ["image", "filename", "image_id"],
      "patient_columns": ["patient_id", "subject_id"],
      "study_columns": ["study_id"],
      "label_columns": ["label", "class"],
      "label_mode": "single_column",
      "identity_policy": "IMAGE_PROXY_REVIEW_REQUIRED",
      "join_key_mode": "basename"
    },
    {
      "dataset_id": "covid_radiography",
      "folder": "10_COVID_Radiography",
      "name": "COVID-19 Radiography Database",
      "adapter_kind": "classification_segmentation",
      "metadata_patterns": ["*.csv", "*.tsv"],
      "image_key_columns": ["image", "filename", "image_id"],
      "patient_columns": ["patient_id", "subject_id"],
      "study_columns": ["study_id"],
      "label_columns": ["label", "class"],
      "label_mode": "single_column",
      "identity_policy": "IMAGE_PROXY_REVIEW_REQUIRED",
      "join_key_mode": "basename"
    }
  ]
}