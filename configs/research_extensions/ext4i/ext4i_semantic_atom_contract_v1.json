    "EVIDENCE_NOT_AVAILABLE": {"required_atoms": ["evidence is not available"], "forbidden_atoms": ["negative finding", "absence inferred", "normality inferred"]},
    "NOT_APPLICABLE": {"required_atoms": ["topic does not apply"], "forbidden_atoms": ["topic absent", "topic negative", "topic missing"]},
    "CONTRADICTORY_EVIDENCE": {"required_atoms": ["signals remain contradictory"], "forbidden_atoms": ["signals reconciled", "contradiction resolved"]},
    "DEFER": {"required_atoms": ["action or decision is deferred"], "forbidden_atoms": ["defer applies only to explanation", "action completed"]}
