    "WITHHELD": {"must_preserve": ["withheld state"], "forbidden": ["unavailable", "absent", "negative", "normal", "no localization"]},
    "CONTRADICTED": {"must_preserve": ["unresolved contradiction"], "forbidden": ["reconciliation", "collapse", "selecting one signal"]},
    "NOT_AVAILABLE": {"must_preserve": ["evidence unavailability only"], "forbidden": ["negative finding", "absence", "normality"]},
    "NOT_APPLICABLE": {"must_preserve": ["non-applicability"], "forbidden": ["absence", "negative finding", "missing evidence"]},
    "DEFER": {"must_preserve": ["decision or action is deferred"], "forbidden": ["explanation is active", "decision completed", "decision overridden"]}
  },
  "required_forbidden_model": {
